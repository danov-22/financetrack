SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Server-only values must never be returned by /api/public-config:
SUPABASE_SECRET_KEY=sb_secret_your_key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-jwt-for-server-side-admin-operations
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ADMIN_EMAIL=you@example.com
APP_ORIGIN=https://bewlet.vercel.app
TOKEN_ENCRYPTION_KEY=generate-a-long-random-secret-of-at-least-32-characters
FEEDBACK_APPS_SCRIPT_URL=https://script.google.com/macros/s/your-feedback-deployment/exec
# Optional email notifications:
RESEND_API_KEY=re_your_key
APP_FROM_EMAIL=Bewlet <access@your-verified-domain.example>
# Public payment instructions shown during registration:
APPROVAL_TIME_TEXT=usually within 24 hours after payment proof is submitted
PAYMENT_ID_BANK_NAME=Your Indonesian bank
PAYMENT_ID_ACCOUNT_NAME=Account holder name
PAYMENT_ID_ACCOUNT_NUMBER=0000000000
PAYMENT_ID_INSTRUCTIONS=Include the registration Gmail address in the transfer note when possible.
PAYMENT_INTL_METHOD=Wise or PayPal
PAYMENT_INTL_ACCOUNT_NAME=Account holder name
PAYMENT_INTL_ACCOUNT=payments@example.com
PAYMENT_INTL_INSTRUCTIONS=Send exactly US$19 and retain the receipt.
